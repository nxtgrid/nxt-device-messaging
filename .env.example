# Copy to `.env` for local compose / runtime. Secrets stay in env (ADR-002 / ADR-005).

# HTTP listen port (ADR-005 §3). Default 3100.
PORT="3100"

# Redis / Valkey connection (ADR-002 §8). Compose sets REDIS_HOST=valkey.
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=
# REDIS_DB=0

# Command API Bearer key (ADR-003 §5). When unset, command routes skip auth (local).
# Local httpYac uses the same value via `apiKey` in `src/http/smoke/.httpyac.cjs`.
DEVICE_MESSAGING_API_KEY="dev-key"

# Outbound event webhook HMAC secret (ADR-003 §6). Opt-in; unset → unsigned + boot warn if URL set.
# DEVICE_MESSAGING_WEBHOOK_SECRET=

# Config artifact (ADR-002 §4). Precedence: JSON → URL → PATH → bundled default.
# `_JSON` = raw JSON string (not a file path). `_PATH` = path to a JSON file.
# DEVICE_MESSAGING_CONFIG_JSON=
# DEVICE_MESSAGING_CONFIG_URL=
DEVICE_MESSAGING_CONFIG_PATH="./config.example.json"

# --- Plugin secrets (ADR-002 §2). Only required when that plugin is in config plugins[]. ---
# calin-api-v1 — required when that id is in plugins[]
# CALIN_API_V1_URL="https://calin-api.example"
# CALIN_API_V1_COMPANY_NAME=
# CALIN_API_V1_ADMIN_USERNAME=
# CALIN_API_V1_ADMIN_PASSWORD=
# CALIN_API_V1_POS_USERNAME=
# CALIN_API_V1_POS_PASSWORD=
# CALIN_API_V1_MAINTENANCE_USERNAME=
# CALIN_API_V1_MAINTENANCE_PASSWORD=

# calin-api-v2 — required when that id is in plugins[]
# CALIN_API_V2_URL="https://calin-api-v2.example"
# CALIN_API_V2_COMPANY_NAME=
# CALIN_API_V2_CUSTOMER_ID=
# CALIN_API_V2_ADMIN_USERNAME=
# CALIN_API_V2_ADMIN_PASSWORD=
# CALIN_API_V2_POS_PASSWORD=

# nxt-sts — required when that id is in plugins[]
# NXT_STS_URL="http://localhost:8080"

# ChirpStack gRPC client — required when `calin-chirpstack` (or any future
# LoRaWAN brand plugin using `_shared/chirpstack-repository`) is in plugins[]
# CHIRPSTACK_API_URL="chirpstack.example:8080"
# CHIRPSTACK_API_TOKEN=
# CHIRPSTACK_APPLICATION_ID=
# CHIRPSTACK_PROFILE_ID=
# CHIRPSTACK_APP_KEY=
