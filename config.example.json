{
  "$schemaVersion": "1",
  "engine": {
    "enabled": true
  },
  "delivery": {
    "maxRetries": 11,
    "retryBaseDelayMs": 2000,
    "retryBackoffMultiplier": 2,
    "retryMaxDelayMs": 3600000,
    "messageTtlSeconds": 604800
  },
  "resultWebhook": {
    "url": "https://consumer.example/hooks/device-messages"
  },
  "plugins": [
    {
      "id": "stub-push",
      "tuning": {
        "nsInFlightTimeoutMs": 15000
      }
    },
    {
      "id": "stub-pull"
    }
  ]
}
