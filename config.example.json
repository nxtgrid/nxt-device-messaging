{
  "$schemaVersion": "1",
  "engine": {
    "enabled": true
  },
  "delivery": {
    "maxRetries": 11,
    "retryBaseDelayMs": 2000,
    "retryBackoffMultiplier": 2,
    "retryMaxDelayMs": 3600000,
    "messageTtlSeconds": 604800,
    "nsInFlightTimeoutMs": 20000,
    "gwInFlightTimeoutMs": 900000,
    "deviceInFlightTimeoutMs": 12000,
    "initialPollDelayMs": 10000
  },
  "resultWebhook": {
    "url": "https://consumer.example/hooks/device-messages"
  },
  "plugins": [
    {
      "id": "stub-push"
    },
    {
      "id": "stub-pull"
    }
  ]
}
