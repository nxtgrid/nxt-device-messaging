{
  "$schemaVersion": "1",
  "engine": {
    "enabled": true
  },
  "delivery": {
    "maxRetries": 11,
    "retryBaseDelayMs": 2000,
    "retryBackoffMultiplier": 2,
    "retryMaxDelayMs": 3600000,
    "messageTtlSeconds": 604800
  },
  "eventWebhook": {
    "url": "https://consumer.example/hooks/device-messages",
    "maxAttempts": 6,
    "baseDelayMs": 2000,
    "backoffMultiplier": 2,
    "maxDelayMs": 60000,
    "requestTimeoutMs": 10000,
    "deadLetterTtlSeconds": 604800
  },
  "plugins": [
    {
      "id": "stub-push",
      "tuning": {
        "nsInFlightTimeoutMs": 15000
      }
    },
    {
      "id": "stub-pull"
    }
  ]
}
