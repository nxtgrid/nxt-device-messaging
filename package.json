{
  "name": "nxt-device-messaging",
  "version": "0.0.0",
  "description": "Reliable, prioritized, retrying command delivery to addressable field devices",
  "license": "MPL-2.0",
  "authors": [
    {
      "name": "Bobby Bol",
      "email": "studio.innua@gmail.com"
    }
  ],
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "imports": {
    "#src/*": "./src/*"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_REDIS_SMOKE=1 vitest run --fileParallelism=false test/integration",
    "test:watch": "vitest"
  },
  "private": true,
  "dependencies": {
    "@chirpstack/chirpstack-api": "^4.19.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-zod": "^1.0.0",
    "@grpc/grpc-js": "^1.14.4",
    "fastify": "^5.10.0",
    "iovalkey": "^0.4.0",
    "openapi-types": "^12.1.3",
    "ramda": "^0.32.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "@types/ramda": "^0.32.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.15"
  },
  "lint-staged": {
    "**/*.ts": "eslint --max-warnings=0 --no-warn-ignored"
  }
}
